# Copy to .env and fill values. NEVER commit .env.

# Unusual Whales API key (Basic tier)
UW_API_KEY=

# Swarm LLM (LiteLLM format). Default: GLM 5.3 Flash via opencode inference
SWARM_MODEL=openai/glm-5.3-flash
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/v1

# Optional overrides
MAX_CANDIDATES=5

# Crews tracing noise off
CREWAI_TRACING_ENABLED=false
